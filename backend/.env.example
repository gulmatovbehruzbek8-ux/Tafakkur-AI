# ==============================================================================
# Tafakkur AI - Backend Environment Variables
# ==============================================================================

# Server Host & Port
PORT=8000
HOST=0.0.0.0

# Ollama Local LLM Configuration
OLLAMA_URL=http://localhost:11434/api/generate
MODEL_NAME=llama3

# Allowed CORS Origins (comma separated list, or wildcards for *.vercel.app)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://tafakkur-ai.vercel.app

# Optional HEMIS API Integration
HEMIS_BASE_URL=https://student.hemis.uz/rest/v1
HEMIS_API_TOKEN=
