# ==============================================================================
# Tafakkur AI - Environment Variables Reference
# ==============================================================================

# [TIER 1: Recommended & 100% Free] Meta Llama 3.3 70B via Groq Cloud
# Get your free key instantly at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# [TIER 2: Remote / Tunneled Ollama]
# Connect your local Ollama via ngrok (e.g. `ngrok http 11434`)
# OLLAMA_URL=https://your-subdomain.ngrok-free.app

# [TIER 3: Alternative Cloud Providers]
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# [Optional: External Backend URL]
# If left blank, Next.js handles all API requests natively via serverless route handlers.
# NEXT_PUBLIC_API_URL=https://your-backend.onrender.com
